---
// One icon family: 1.5px stroke, round caps, 24px grid. WhatsApp keeps its brand glyph (filled) by necessity.
interface Props { name: 'arrow' | 'arrow-left' | 'close' | 'play' | 'pin' | 'whatsapp' | 'menu' | 'chat' | 'award'; class?: string }
const { name, class: cls = 'size-4' } = Astro.props;
---
{name === 'whatsapp' ? (
  <svg aria-hidden="true" viewBox="0 0 24 24" class:list={['shrink-0 fill-current', cls]}><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41"/></svg>
) : (
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class:list={['shrink-0', cls]}>
    {name === 'arrow' && <path d="M4 12h16m-6-6 6 6-6 6" />}
    {name === 'arrow-left' && <path d="M20 12H4m6-6-6 6 6 6" />}
    {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
    {name === 'play' && <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" />}
    {name === 'pin' && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.3" /></>}
    {name === 'menu' && <path d="M4 8h16M4 16h16" />}
    {name === 'chat' && <path d="M20 12a8 8 0 0 1-11.6 7.1L4 20l1-4.1A8 8 0 1 1 20 12z" />}
    {name === 'award' && <><circle cx="12" cy="9" r="5.5" /><path d="m8.5 13.3-1.5 7.2 5-2.6 5 2.6-1.5-7.2" /></>}
  </svg>
)}
