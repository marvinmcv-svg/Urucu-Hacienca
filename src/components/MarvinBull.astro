---
// Marvin's mark: a black bull, head-on, horns up, ember eyes.
// Alive but not busy: the eyes smoulder, the head gives a short snort every few seconds and breath steams from the nostrils.
// Motion stops for visitors who prefer reduced motion.
interface Props { class?: string; title?: string }
const { class: cls = 'size-10', title } = Astro.props;
const uid = `mb${Math.random().toString(36).slice(2, 8)}`;
---
<svg viewBox="0 0 64 64" class:list={['mbull', cls]} role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'} aria-label={title}>
  <defs>
    <radialGradient id={`${uid}-bg`} cx="50%" cy="42%" r="60%">
      <stop offset="0" stop-color="#2a0f08" />
      <stop offset=".65" stop-color="#0d0d0c" />
      <stop offset="1" stop-color="#050505" />
    </radialGradient>
    <linearGradient id={`${uid}-horn`} x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#3a3632" />
      <stop offset=".55" stop-color="#c9bba3" />
      <stop offset="1" stop-color="#f2ece1" />
    </linearGradient>
    <linearGradient id={`${uid}-head`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2b2b2a" />
      <stop offset=".45" stop-color="#121212" />
      <stop offset="1" stop-color="#050505" />
    </linearGradient>
    <filter id={`${uid}-glow`} x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur stdDeviation="1.1" result="b" />
      <feMerge><feMergeNode in="b" /><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
  </defs>
  <circle cx="32" cy="32" r="32" fill={`url(#${uid}-bg)`} />
  <circle class="mb-aura" cx="32" cy="32" r="30.5" fill="none" stroke="#e8835c" stroke-width="1" />
  <g class="mb-head">
    <!-- horns -->
    <path d="M22.5 22.5C13 23.5 5.5 19 6.5 6.5 9 13 14 16.5 22 17.2Z" fill={`url(#${uid}-horn)`} />
    <path d="M41.5 22.5C51 23.5 58.5 19 57.5 6.5 55 13 50 16.5 42 17.2Z" fill={`url(#${uid}-horn)`} />
    <!-- ears -->
    <path d="M21 25.5c-5 .2-8.5 2.5-10.5 6 4.5.6 8.6-.3 11.6-2.6Z" fill="#161616" />
    <path d="M43 25.5c5 .2 8.5 2.5 10.5 6-4.5.6-8.6-.3-11.6-2.6Z" fill="#161616" />
    <!-- skull and face -->
    <path d="M22 17.5c6-2.6 14-2.6 20 0 3.2 4.6 3.4 12 .6 20.5-1 3.3-1.7 7.6-2.6 12.6-1.4 5.6-14.6 5.6-16 0-.9-5-1.6-9.3-2.6-12.6-2.8-8.5-2.6-15.9.6-20.5Z" fill={`url(#${uid}-head)`} />
    <!-- forelock -->
    <path d="M26 18.2c1.6 2.4 3.3 1 4.2 3 1-2.4 2.6-.6 3.8-3 1 2.2 2.6 1.4 4 .1-1.4 3.6-4.8 4.6-6 6.2-1.4-1.8-4.7-2.4-6-6.3Z" fill="#2e2e2d" />
    <!-- brow: angled down to the centre -->
    <path d="M22.6 28.4 29.6 31.4M41.4 28.4 34.4 31.4" stroke="#3b3b3a" stroke-width="1.6" stroke-linecap="round" />
    <!-- eyes -->
    <g class="mb-eyes" filter={`url(#${uid}-glow)`} fill="#ff6a2b">
      <path d="M23.6 30.6 29.4 33.1 25 33.9Z" />
      <path d="M40.4 30.6 34.6 33.1 39 33.9Z" />
    </g>
    <!-- muzzle -->
    <ellipse cx="32" cy="50" rx="8.6" ry="5.6" fill="#1d1d1c" />
    <ellipse cx="28.3" cy="50.3" rx="1.7" ry="1.3" fill="#000" />
    <ellipse cx="35.7" cy="50.3" rx="1.7" ry="1.3" fill="#000" />
    <!-- nose ring -->
    <path d="M28.6 53.2a3.4 3.4 0 0 0 6.8 0" fill="none" stroke="#c9a24a" stroke-width="1.4" stroke-linecap="round" />
  </g>
  <!-- breath -->
  <g class="mb-steam" fill="#f2ece1">
    <circle class="mb-puff mb-puff-l" cx="27" cy="54" r="2" />
    <circle class="mb-puff mb-puff-r" cx="37" cy="54" r="2" />
  </g>
</svg>

<style is:global>
  .mbull { overflow: visible; }
  .mbull .mb-head { transform-box: view-box; transform-origin: 32px 40px; animation: mb-snort 4.8s cubic-bezier(.3, 0, .2, 1) infinite; }
  .mbull .mb-eyes { animation: mb-eyes 2.4s ease-in-out infinite; }
  .mbull .mb-aura { opacity: .35; transform-box: view-box; transform-origin: 32px 32px; animation: mb-aura 4.8s ease-out infinite; }
  .mbull .mb-puff { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .mbull .mb-puff-l { animation: mb-puff-l 4.8s ease-out infinite; }
  .mbull .mb-puff-r { animation: mb-puff-r 4.8s ease-out infinite; }
  @keyframes mb-snort {
    0%, 62%, 100% { transform: none; }
    66% { transform: translateY(-1.2px) rotate(-2deg); }
    70% { transform: translateY(.8px) rotate(1.5deg) scale(1.02); }
    76% { transform: translateY(-.4px) rotate(-.6deg); }
    82% { transform: none; }
  }
  @keyframes mb-eyes { 0%, 100% { opacity: .75; } 50% { opacity: 1; } }
  @keyframes mb-aura { 0%, 66% { opacity: .35; transform: scale(1); } 74% { opacity: .9; transform: scale(1.02); } 100% { opacity: .35; transform: scale(1); } }
  @keyframes mb-puff-l { 0%, 68% { opacity: 0; transform: translate(0, 0) scale(.4); } 74% { opacity: .55; } 92%, 100% { opacity: 0; transform: translate(-7px, 4px) scale(2.2); } }
  @keyframes mb-puff-r { 0%, 68% { opacity: 0; transform: translate(0, 0) scale(.4); } 74% { opacity: .55; } 92%, 100% { opacity: 0; transform: translate(7px, 4px) scale(2.2); } }
  @media (prefers-reduced-motion: reduce) { .mbull * { animation: none !important; } .mbull .mb-eyes { opacity: 1; } }
</style>
