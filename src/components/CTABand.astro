---
import WaButton from './WaButton.astro';
import LinkButton from './LinkButton.astro';
import { href, useT, type Locale } from '../i18n/ui';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useT(lang);
---
<section class="on-ink bg-achiote text-paper">
  <div class="container-x grid gap-10 py-20 lg:grid-cols-[1.3fr_1fr] lg:items-end lg:py-28">
    <div>
      <h2 class="text-[2.6rem] leading-[1] sm:text-6xl lg:text-[5rem]">{t('band.title')}</h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-paper">{t('band.lead')}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
      <WaButton intent="general" lang={lang} variant="paper">{t('cta.whatsapp')}</WaButton>
      <LinkButton href={`${href(lang, 'contact')}#consulta`} variant="light">{t('cta.visit')}</LinkButton>
    </div>
  </div>
</section>
