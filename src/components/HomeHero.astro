---
// Home hero. Always exactly one screen tall.
// Desktop (wide + landscape): three films side by side in equal columns, full bleed: Campo · Nelore · Sindi.
//   Each column is labelled; hovering one brings it forward. The headline sits across the foot.
// Phones and portrait tablets: all five films in a story-style carousel that rotates on its own.
//   Progress bars at the top, tap left/right or swipe to move, and the chapter name tells you what you are watching.
import WaButton from './WaButton.astro';
import LinkButton from './LinkButton.astro';
import { href, useT, type Locale } from '../i18n/ui';
import { aiTotal, breeds } from '../data/site';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useT(lang);
const words = t('home.hero.title').split(' ');
const breed = (id: string) => breeds.find((b) => b.id === id)!.name[lang];
const gist = (id: string) => breeds.find((b) => b.id === id)!.text[lang].split('.')[0] + '.';
const fmt = (n: number) => n.toLocaleString(lang, { maximumFractionDigits: 2 });

// The first three are the desktop columns; phones rotate through all five.
const films = [
  { id: 'campo', word: t('home.ch.field'), cap: 'Hacienda Pesquería', line: t('home.ch.field_d'), to: href(lang, 'about') },
  { id: 'nelore-close', word: breed('nelore'), cap: 'Galáctico FIV Urucú', line: gist('nelore'), to: `${href(lang, 'genetics')}#nelore` },
  { id: 'sindi-close', word: breed('sindi'), cap: 'Amira de Rincón del Urucú', line: gist('sindi'), to: `${href(lang, 'genetics')}#sindi` },
  { id: 'fertilidad', word: t('home.ch.fertility'), cap: 'Hacienda Pesquería', line: `${fmt(aiTotal)}% ${t('home.proof.pregnancy')}`, to: href(lang, 'genetics') },
  { id: 'campeones', word: t('home.ch.champions'), cap: 'FexpoSIV 2026', line: t('home.proof.champion_sub'), to: href(lang, 'herd') },
];
---
<section id="hero" data-hide-dock data-header-dark class="hx on-ink relative isolate overflow-hidden bg-ink text-paper" aria-roledescription="carousel">
  <div class="hx-films">
    {films.map((f, i) => (
      <a href={f.to} class:list={['hx-film', i > 2 && 'hx-extra']} data-i={i} tabindex="-1" aria-label={f.word}>
        <video muted playsinline loop preload={i === 0 ? 'auto' : 'none'} autoplay={i === 0} poster={`/media/film/${f.id}.jpg`} aria-hidden="true">
          <source src={`/media/film/${f.id}.mp4`} type="video/mp4" />
        </video>
        <span class="hx-col-label" aria-hidden="true">
          <span class="hx-col-n num">0{i + 1}</span>
          <span class="hx-col-word">{f.word}</span>
          <span class="hx-col-cap">{f.cap}</span>
        </span>
      </a>
    ))}
  </div>
  <div class="hx-shade" aria-hidden="true"></div>

  <!-- phones: story progress + current chapter -->
  <div class="hx-bars" aria-hidden="true">{films.map(() => <i><b></b></i>)}</div>
  <div class="hx-tap" aria-hidden="true"><span data-dir="-1"></span><span data-dir="1"></span></div>

  <div class="hx-copy container-x">
    <div class="hx-chapter" aria-live="polite">
      {films.map((f, i) => (
        <p class="hx-ch" data-i={i}><span class="hx-ch-n num">0{i + 1}/0{films.length}</span><span class="hx-ch-word">{f.word}</span><span class="hx-ch-line">{f.line}</span></p>
      ))}
    </div>
    <h1 class="hx-title" aria-label={t('home.hero.title')}>
      {words.map((w, i) => <span aria-hidden="true" class="hero-word"><span style={`animation-delay:${120 + i * 70}ms`}>{w}</span></span>)}
    </h1>
    <div class="hx-foot hero-fade">
      <p class="hx-tag"><em>{t('meta.tagline')}</em><span aria-hidden="true"> · </span>Nelore · Nelore Mocho · Sindi</p>
      <div class="hx-ctas">
        <WaButton intent="general" lang={lang}>{t('cta.talk')}</WaButton>
        <LinkButton href={href(lang, 'herd')} variant="light">{t('cta.herd')}</LinkButton>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ---------- Phones and portrait tablets: story carousel of five films ---------- */
  .hx { height: 100svh; min-height: 36rem; display: flex; flex-direction: column; justify-content: flex-end; }
  .hx-films { position: absolute; inset: 0; z-index: -2; }
  .hx-film { position: absolute; inset: 0; opacity: 0; transition: opacity .9s var(--ease-out-expo); }
  .hx-film[data-on] { opacity: 1; }
  .hx-film video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); transition: transform 7s linear; }
  .hx-film[data-on] video { transform: scale(1); }
  .hx-col-label { display: none; }
  .hx-shade { position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(to top, rgb(12 16 13 / .97) 0%, rgb(12 16 13 / .82) 45%, rgb(12 16 13 / .35) 66%, rgb(12 16 13 / .05) 78%, rgb(12 16 13 / .55) 100%); }
  .hx-bars { position: absolute; top: 4.9rem; left: 1.25rem; right: 1.25rem; display: flex; gap: .3rem; z-index: 2; }
  .hx-bars i { flex: 1; height: 2px; border-radius: 2px; background: rgb(242 236 225 / .28); overflow: hidden; }
  .hx-bars b { display: block; height: 100%; background: var(--color-paper); transform-origin: left; transform: scaleX(0); }
  .hx-bars i.done b { transform: scaleX(1); }
  .hx-tap { position: absolute; inset: 5.5rem 0 45% 0; display: flex; z-index: 1; }
  .hx-tap span { flex: 1; }
  .hx-copy { position: relative; z-index: 2; padding-bottom: max(1.75rem, env(safe-area-inset-bottom)); }
  .hx-chapter { display: grid; margin-bottom: 1rem; }
  .hx-ch { grid-area: 1 / 1; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: .6rem; opacity: 0; transform: translateY(8px); transition: opacity .6s, transform .6s var(--ease-out-expo); }
  .hx-ch[data-on] { opacity: 1; transform: none; }
  .hx-ch-n { font-size: .75rem; color: var(--color-dust); letter-spacing: .08em; }
  .hx-ch-word { font-family: var(--font-display); font-size: 1.5rem; font-style: italic; color: var(--color-ember); }
  .hx-ch-line { flex-basis: 100%; font-size: .9375rem; color: rgb(242 236 225 / .85); }
  .hx-ch { text-shadow: 0 1px 12px rgb(0 0 0 / .6); }
  .hx-title { font-size: clamp(2.8rem, 12.5vw, 5.5rem); line-height: .94; letter-spacing: -0.025em; max-width: 12ch; }
  .hx-tag { margin-top: 1rem; font-size: 1rem; color: rgb(242 236 225 / .8); }
  .hx-tag em { font-family: var(--font-display); font-size: 1.2em; }
  .hx-ctas { margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: .625rem; }
  .hx-ctas > a { flex: 1 1 auto; }

  /* ---------- Desktop: three equal columns, full bleed ---------- */
  @media (min-width: 64rem) and (orientation: landscape) {
    .hx { min-height: 40rem; }
    .hx-films { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; background: var(--color-ink); }
    .hx-film { position: relative; inset: auto; opacity: 1; overflow: hidden; transition: filter .8s var(--ease-out-expo);
      animation: hx-col 1.4s var(--ease-out-expo) backwards; }
    .hx-film:nth-child(2) { animation-delay: .12s; } .hx-film:nth-child(3) { animation-delay: .24s; }
    .hx-extra { display: none; }
    .hx-film video { transform: scale(1.02); transition: transform 1.6s var(--ease-out-expo); }
    .hx-films:hover .hx-film { filter: brightness(.55) saturate(.8); }
    .hx-films:hover .hx-film:hover { filter: none; }
    .hx-film:hover video { transform: scale(1.07); }
    .hx-col-label { display: flex; flex-direction: column; position: absolute; top: 6.5rem; left: 2rem; right: 2rem; z-index: 1; }
    .hx-col-n { font-size: .75rem; letter-spacing: .1em; color: var(--color-dust); }
    .hx-col-word { font-family: var(--font-display); font-size: clamp(1.8rem, 2.6vw, 2.75rem); line-height: 1; margin-top: .4rem; }
    .hx-col-cap { margin-top: .5rem; font-family: var(--font-sans); font-stretch: 78%; font-size: .75rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: rgb(242 236 225 / .7); }
    .hx-film::before { content: ''; position: absolute; inset: 0 0 auto; height: 16rem; z-index: 1; background: linear-gradient(to bottom, rgb(12 16 13 / .7), transparent); pointer-events: none; }
    .hx-shade { background: linear-gradient(to top, rgb(12 16 13 / .95) 0%, rgb(12 16 13 / .65) 32%, transparent 58%); }
    .hx-bars, .hx-tap, .hx-chapter { display: none; }
    .hx-copy { padding-bottom: 3rem; pointer-events: none; }
    .hx-copy a { pointer-events: auto; }
    .hx-title { font-size: min(7.2vw, 13svh, 8.5rem); max-width: none; }
    .hx-foot { margin-top: 1.25rem; max-width: calc(100% - 18rem); }
    .hx-tag { margin: 0; font-size: 1.125rem; }
    .hx-ctas { margin-top: 1.5rem; gap: .75rem; }
    .hx-ctas > a { flex: 0 0 auto; }
  }
  /* phones held sideways */
  @media (orientation: landscape) and (max-height: 32rem) and (max-width: 63.99rem) {
    .hx { min-height: 0; }
    .hx-title { font-size: min(14svh, 8vw); max-width: none; }
    .hx-tag, .hx-ch-line { display: none; }
    .hx-bars { top: 4.75rem; }
    .hx-ctas { margin-top: .75rem; }
    .hx-ctas > a { flex: 0 0 auto; }
  }
  @keyframes hx-col { from { opacity: 0; transform: translateY(40px); } }
  @media (prefers-reduced-motion: reduce) { .hx-film, .hx-film video { animation: none !important; transition: none !important; } }
</style>

<script>
  import { want, warm, DESKTOP, reducedMotion } from '../lib/film';
  const hero = document.getElementById('hero')!;
  const items = [...hero.querySelectorAll<HTMLAnchorElement>('.hx-film')];
  const vids = items.map((a) => a.querySelector('video')!);
  const chs = [...hero.querySelectorAll<HTMLElement>('.hx-ch')];
  const bars = [...hero.querySelectorAll<HTMLElement>('.hx-bars i')];
  const desk = matchMedia(DESKTOP);
  const still = reducedMotion();
  const n = items.length;
  let cur = 0, visible = true, t0 = 0, dur = 6000, paused = false, progress = 0;

  function show(i: number) {
    cur = (i + n) % n;
    items.forEach((a, k) => { a.toggleAttribute('data-on', k === cur); a.tabIndex = k === cur ? 0 : -1; });
    chs.forEach((c, k) => c.toggleAttribute('data-on', k === cur));
    bars.forEach((b, k) => { b.classList.toggle('done', k < cur); (b.firstElementChild as HTMLElement).style.transform = k < cur ? 'scaleX(1)' : 'scaleX(0)'; });
    const v = vids[cur];
    if (v.readyState < 1) v.preload = 'auto';
    v.currentTime = 0;
    dur = Math.max(5000, (Number.isFinite(v.duration) && v.duration > 0 ? v.duration : 6) * 1000);
    v.addEventListener('loadedmetadata', () => { if (cur === items.indexOf(v.parentElement as HTMLAnchorElement)) dur = Math.max(5000, v.duration * 1000); }, { once: true });
    warm(vids[(cur + 1) % n]);
    t0 = performance.now();
    progress = 0;
    sync();
  }

  function sync() {
    const d = desk.matches;
    vids.forEach((v, k) => want(v, visible && !paused && (d ? k < 3 : k === cur)));
  }

  function tick(now: number) {
    requestAnimationFrame(tick);
    if (desk.matches || !visible || paused || still) { t0 = now - progress * dur; return; }
    progress = Math.min(1, (now - t0) / dur);
    (bars[cur].firstElementChild as HTMLElement).style.transform = `scaleX(${progress})`;
    if (progress >= 1) show(cur + 1);
  }

  // tap zones and swipes (phones)
  hero.querySelectorAll<HTMLElement>('.hx-tap span').forEach((z) => z.addEventListener('click', () => show(cur + Number(z.dataset.dir))));
  let sx = 0, sy = 0;
  hero.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; paused = true; sync(); }, { passive: true });
  hero.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
    paused = false;
    if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) show(cur + (dx < 0 ? 1 : -1));
    else { t0 = performance.now() - progress * dur; sync(); }
  }, { passive: true });

  new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }).observe(hero);
  document.addEventListener('visibilitychange', () => { visible = !document.hidden; sync(); });
  desk.addEventListener('change', () => { if (desk.matches) vids.slice(0, 3).forEach(warm); sync(); });
  if (desk.matches) vids.slice(0, 3).forEach(warm);
  show(0);
  requestAnimationFrame(tick);
</script>
