---
import Icon from './Icon.astro';
import { waLink, type Intent } from '../lib/wa';
import type { Locale } from '../i18n/ui';
interface Props { intent: Intent; lang: Locale; vars?: Record<string, string | number | undefined>; variant?: 'wa' | 'achiote' | 'ghost' | 'light' | 'paper'; size?: 'md' | 'sm'; class?: string }
const { intent, lang, vars = {}, variant = 'wa', size = 'md', class: cls = '' } = Astro.props;
const styles = {
  wa: 'bg-wa-dark text-white hover:bg-[#0b6334]',
  achiote: 'bg-achiote text-paper hover:bg-achiote-deep',
  ghost: 'border border-ink/30 text-ink hover:border-ink hover:bg-ink hover:text-paper',
  light: 'border border-paper/40 text-paper hover:bg-paper hover:text-ink',
  paper: 'bg-paper text-ink hover:bg-white',
};
---
<a href={waLink(intent, lang, vars)} target="_blank" rel="noopener" data-wa-intent={intent}
  class:list={['group/btn inline-flex items-center justify-center gap-3 rounded-[3px] font-semibold transition-colors duration-200',
    size === 'md' ? 'min-h-13 px-6 text-[0.9375rem]' : 'min-h-11 px-5 text-sm', styles[variant], cls]}>
  <Icon name="whatsapp" class={size === 'md' ? 'size-[1.15rem]' : 'size-4'} />
  <slot />
</a>
