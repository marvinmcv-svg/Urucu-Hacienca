---
// Scroll-driven opening for the home page.
// Scene 1: full-bleed film contracts into a vertical card; two breed films fly in beside it; URUCÚ rises behind.
// Scene 2: three chapters; each film wipes up over the last as you scroll.
// Progressive: without JS or with reduced motion, both scenes render as ordinary stacked sections.
import WaButton from './WaButton.astro';
import LinkButton from './LinkButton.astro';
import { href, useT, type Locale } from '../i18n/ui';
import { aiTotal } from '../data/site';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useT(lang);
const words = t('home.hero.title').split(' ');
const fmt = (n: number) => n.toLocaleString(lang, { maximumFractionDigits: 2 });
const film = (id: string) => ({ src: `/media/film/${id}.mp4`, poster: `/media/film/${id}.jpg` });
const chapters = [
  { id: 'campo', word: t('home.ch.field'), figure: null, detail: t('home.ch.field_d') },
  { id: 'fertilidad', word: t('home.ch.fertility'), figure: `${fmt(aiTotal)}%`, detail: t('home.proof.pregnancy') },
  { id: 'campeones', word: t('home.ch.champions'), figure: null, detail: `${t('home.proof.champion')} · FexpoSIV 2026` },
];
---
<!-- Scene 1 -->
<section id="cine-open" data-hide-dock data-header-dark class="cine-open on-ink relative bg-ink text-paper" aria-label={t('home.hero.title')}>
  <div class="cine-stage">
    <div class="cine-ambient" aria-hidden="true" style="background-image:url(/media/film/gate-blur.jpg)"></div>

    <p aria-hidden="true" class="cine-word">URUCÚ</p>

    <figure class="cine-side cine-side-l" aria-hidden="true">
      <video muted loop playsinline preload="none" poster={film('nelore').poster} data-lazy><source src={film('nelore').src} type="video/mp4" /></video>
      <figcaption>Nelore</figcaption>
    </figure>
    <figure class="cine-side cine-side-r" aria-hidden="true">
      <video muted loop playsinline preload="none" poster={film('sindi').poster} data-lazy><source src={film('sindi').src} type="video/mp4" /></video>
      <figcaption>Sindi</figcaption>
    </figure>

    <div class="cine-frame">
      <video autoplay muted loop playsinline preload="auto" poster={film('gate').poster} aria-hidden="true"><source src={film('gate').src} type="video/mp4" /></video>
      <div class="cine-frame-shade"></div>
    </div>

    <div class="cine-intro container-x">
      <h1 class="max-w-[13ch] text-[3.4rem] leading-[0.94] tracking-[-0.025em] sm:text-7xl lg:text-[8rem] xl:text-[9rem]" aria-label={t('home.hero.title')}>
        {words.map((w, i) => <span aria-hidden="true" class="hero-word"><span style={`animation-delay:${i * 70}ms`}>{w}</span></span>)}
      </h1>
      <div class="hero-fade mt-8 flex flex-wrap items-center gap-x-8 gap-y-4 lg:mt-10">
        <WaButton intent="general" lang={lang}>{t('cta.talk')}</WaButton>
        <p class="cine-cue label text-paper/75"><span class="cine-cue-line" aria-hidden="true"></span>{t('home.scroll')}</p>
      </div>
    </div>

    <div class="cine-outro">
      <p class="font-display text-[1.6rem] italic leading-tight text-paper/90 sm:text-3xl">{t('meta.tagline')}</p>
      <div class="mt-5 flex flex-wrap justify-center gap-2.5 sm:mt-6 sm:gap-3">
        <WaButton intent="general" lang={lang}>{t('cta.talk')}</WaButton>
        <LinkButton href={href(lang, 'herd')} variant="light">{t('cta.herd')}</LinkButton>
      </div>
    </div>
  </div>
</section>

<!-- Scene 2 -->
<section id="cine-chapters" data-hide-dock data-header-dark class="cine-ch on-ink relative bg-ink text-paper" aria-label={t('home.proof.title')}>
  <div class="cine-stage">
    {chapters.map((c, i) => (
      <article class="cine-layer" data-i={i}>
        <video muted loop playsinline preload="none" poster={film(c.id).poster} data-lazy aria-hidden="true"><source src={film(c.id).src} type="video/mp4" /></video>
        <div class="cine-layer-shade" aria-hidden="true"></div>
        <div class="cine-copy container-x">
          {c.figure && <p class="cine-fig num font-display [text-shadow:0_2px_30px_rgb(20_28_23/0.6)] text-[4.5rem] leading-none text-ember sm:text-8xl lg:text-[8.5rem]">{c.figure}</p>}
          <h2 class="cine-title text-[3.6rem] leading-[0.9] tracking-[-0.03em] sm:text-8xl lg:text-[11rem]">{c.word}</h2>
          <p class="cine-detail mt-5 max-w-md text-lg leading-snug text-paper/85 lg:text-xl">{c.detail}</p>
        </div>
      </article>
    ))}
    <ol class="cine-progress container-x" aria-hidden="true">
      {chapters.map((c) => <li><span class="label">{c.word}</span><i><b></b></i></li>)}
    </ol>
    <p class="cine-place label container-x" aria-hidden="true">{t('home.ch.label')}</p>
  </div>
</section>

<style is:global>
  /* ---------- Static baseline (no JS / reduced motion) ---------- */
  .cine-stage { position: relative; overflow: hidden; }
  .cine-open .cine-stage { min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; }
  .cine-ambient, .cine-word, .cine-side, .cine-outro, .cine-progress { display: none; }
  .cine-frame { position: absolute; inset: 0; overflow: hidden; }
  .cine-frame video, .cine-layer video, .cine-side video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cine-frame-shade { position: absolute; inset: 0; background: linear-gradient(to top, rgb(20 28 23 / .92), rgb(20 28 23 / .35) 50%, rgb(20 28 23 / .15) 80%); }
  .cine-intro { position: relative; z-index: 3; padding-top: 8rem; padding-bottom: 3rem; }
  .cine-cue { display: inline-flex; align-items: center; gap: .75rem; }
  .cine-cue-line { display: block; width: 2.5rem; height: 1px; background: currentColor; transform-origin: left; animation: cue 2.4s var(--ease-out-expo) infinite; }
  @keyframes cue { 0% { transform: scaleX(0); } 60%, 100% { transform: scaleX(1); opacity: 0; } }

  .cine-layer { position: relative; height: 100svh; min-height: 34rem; overflow: hidden; display: flex; align-items: flex-end; }
  .cine-layer-shade { position: absolute; inset: 0; background: linear-gradient(to top, rgb(20 28 23 / .94), rgb(20 28 23 / .6) 40%, rgb(20 28 23 / .1) 72%), linear-gradient(to bottom, rgb(20 28 23 / .55), transparent 22%); }
  .cine-copy { position: relative; z-index: 2; padding-bottom: 5.5rem; }
  .cine-place { position: absolute; z-index: 4; top: 6rem; left: 0; right: 0; color: var(--color-dust); }

  /* ---------- Cinematic mode (JS adds .cine to <html>) ---------- */
  .cine .cine-open { height: 340svh; }
  .cine .cine-ch { height: 360svh; }
  .cine .cine-stage { position: sticky; top: 0; height: 100svh; min-height: 0; display: block; }
  .cine .cine-ambient { display: block; position: absolute; inset: -10%; background-size: cover; background-position: center; opacity: 0; will-change: opacity; }
  .cine .cine-frame { inset: auto; left: 0; top: 0; border-radius: 4px; will-change: transform; z-index: 2; }
  .cine .cine-intro { position: absolute; inset: auto 0 0 0; will-change: transform, opacity; }
  .cine .cine-word {
    display: block; position: absolute; left: 0; right: 0; top: 50%; z-index: 1; margin: 0; text-align: center;
    font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em; line-height: .8;
    font-size: clamp(6rem, 27vw, 30rem); color: var(--color-paper); opacity: 0; will-change: transform, opacity;
  }
  .cine .cine-side { display: block; position: absolute; left: 0; top: 0; margin: 0; overflow: hidden; border-radius: 4px; z-index: 1; opacity: 0; will-change: transform, opacity; box-shadow: 0 30px 60px -25px rgb(0 0 0 / .7); }
  .cine .cine-side figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 2.5rem .9rem .8rem; font-family: var(--font-display); font-size: clamp(1.1rem, 2vw, 1.6rem); background: linear-gradient(to top, rgb(20 28 23 / .75), transparent); }
  .cine .cine-outro { display: block; position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; padding: 0 1.25rem max(2rem, env(safe-area-inset-bottom)); text-align: center; opacity: 0; visibility: hidden; will-change: transform, opacity; }

  .cine .cine-layer { position: absolute; inset: 0; height: auto; min-height: 0; will-change: clip-path; }
  .cine .cine-layer video { will-change: transform; }
  .cine .cine-copy > * { will-change: transform, opacity; }
  .cine .cine-progress { display: flex; position: absolute; left: 0; right: 0; bottom: 1.75rem; z-index: 4; gap: 1rem; }
  .cine .cine-progress li { flex: 1; max-width: 10rem; color: rgb(242 236 225 / .55); transition: color .3s; }
  .cine .cine-progress li[data-on] { color: var(--color-paper); }
  .cine .cine-progress i { display: block; margin-top: .5rem; height: 2px; background: rgb(242 236 225 / .2); overflow: hidden; }
  .cine .cine-progress b { display: block; height: 100%; background: var(--color-ember); transform: scaleX(0); transform-origin: left; }
  .cine .cine-copy { padding-bottom: 6.5rem; }
  @media (width < 40rem) { .cine .cine-progress span { display: none; } }
</style>

<script>
  const root = document.documentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const open = document.getElementById('cine-open')!;
  const chap = document.getElementById('cine-chapters')!;
  const $ = <T extends HTMLElement>(s: string, el: ParentNode = document) => el.querySelector(s) as T;

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const ease = (x: number) => 1 - Math.pow(1 - clamp(x), 3);          // easeOutCubic
  const io = (x: number) => { x = clamp(x); return x < .5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2; };
  const span = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  // Decode only the films that can actually be seen: decoding is the main cost on phones.
  const pending = new WeakSet<HTMLVideoElement>();
  function want(v: HTMLVideoElement, on: boolean) {
    if (on) {
      if (!v.paused || pending.has(v)) return;
      if (v.preload === 'none') v.preload = 'auto';
      pending.add(v);
      v.play().catch(() => {}).finally(() => pending.delete(v));
    } else if (!v.paused) v.pause();
  }
  const allFilms = [...document.querySelectorAll<HTMLVideoElement>('.cine-open video, .cine-ch video')];

  if (reduce.matches) {
    const vio = new IntersectionObserver((es) => es.forEach((e) => want(e.target as HTMLVideoElement, e.isIntersecting)));
    allFilms.forEach((v) => vio.observe(v));
  } else {
    root.classList.add('cine');
    const frame = $('.cine-frame', open), intro = $('.cine-intro', open), word = $('.cine-word', open);
    const ambient = $('.cine-ambient', open), outro = $('.cine-outro', open), shade = $('.cine-frame-shade', open);
    const sideL = $('.cine-side-l', open), sideR = $('.cine-side-r', open);
    const layers = [...chap.querySelectorAll<HTMLElement>('.cine-layer')];
    const bars = [...chap.querySelectorAll<HTMLElement>('.cine-progress li')];
    const place = $('.cine-place', chap);
    const gateV = $<HTMLVideoElement>('video', frame), sideV = [sideL, sideR].map((el) => $<HTMLVideoElement>('video', el));
    const copies = layers.map((l) => [...l.querySelectorAll<HTMLElement>('.cine-copy > *')]);
    const inView = (el: HTMLElement) => { const r = el.getBoundingClientRect(); return r.bottom > 0 && r.top < H; };
    let W = 0, H = 0, cw = 0, ch = 0, cx = 0, cy = 0, ticking = false;

    function measure() {
      W = innerWidth; H = innerHeight;
      const mobile = W < 640;
      ch = mobile ? Math.min(H * 0.5, (W * 0.56) * 16 / 9) : Math.min(H * 0.64, W * 0.3 * 16 / 9);
      cw = ch * 9 / 16;
      cx = (W - cw) / 2;
      cy = mobile ? H * 0.1 + 34 : H * 0.1 + 34;
      for (const el of [frame, sideL, sideR]) { el.style.width = `${cw}px`; el.style.height = `${ch}px`; }
      update();
    }

    function sceneProgress(el: HTMLElement) {
      const r = el.getBoundingClientRect();
      return clamp(-r.top / (r.height - H || 1));
    }

    function update() {
      ticking = false;
      // ---- Scene 1
      const p = sceneProgress(open);
      const a = io(span(p, 0.02, 0.48));                   // frame contracts
      const cover = Math.max(W / cw, H / ch);              // scale that fills the viewport
      const s = lerp(cover, 1, a);
      const fx = lerp((W - cw) / 2, cx, a), fy = lerp((H - ch) / 2, cy, a);
      frame.style.transform = `translate3d(${fx}px, ${fy}px, 0) scale(${s})`;
      frame.style.transformOrigin = '50% 50%';
      frame.style.borderRadius = `${lerp(0, 6, a) / s}px`;
      shade.style.opacity = String(lerp(1, 0.15, a));

      const ti = span(p, 0, 0.2);
      intro.style.opacity = String(1 - ti);
      intro.style.transform = `translate3d(0, ${-ti * 60}px, 0)`;
      intro.style.visibility = ti >= 1 ? 'hidden' : '';

      ambient.style.opacity = String(a * 0.45);

      const c = ease(span(p, 0.3, 0.72));
      const mobile = W < 640;
      const off = mobile ? cw * 0.62 : cw * 1.06;
      const sideScale = mobile ? 0.8 : 0.86;
      const far = W * 0.7;
      sideL.style.transform = `translate3d(${cx - lerp(off + far, off, c)}px, ${cy + lerp(80, 18, c)}px, 0) rotate(${lerp(-14, -4, c)}deg) scale(${sideScale})`;
      sideR.style.transform = `translate3d(${cx + lerp(off + far, off, c)}px, ${cy + lerp(80, 18, c)}px, 0) rotate(${lerp(14, 4, c)}deg) scale(${sideScale})`;
      sideL.style.opacity = sideR.style.opacity = String(c);

      const w = ease(span(p, 0.42, 0.8));
      word.style.opacity = String(w * 0.95);
      word.style.transform = `translate3d(0, ${lerp(30, -50, w)}%, 0) scale(${lerp(0.92, 1, w)})`;

      const o = ease(span(p, 0.62, 0.86));
      outro.style.opacity = String(o);
      outro.style.visibility = o > 0.02 ? 'visible' : 'hidden';
      outro.style.transform = `translate3d(0, ${lerp(30, 0, o)}px, 0)`;

      // ---- Scene 2
      const q = sceneProgress(chap);
      const n = layers.length;
      layers.forEach((layer, i) => {
        // reveal: layer 0 is always shown; others wipe up near their boundary
        const r = i === 0 ? 1 : io(span(q, i / n - 0.12, i / n + 0.1));
        layer.style.clipPath = i === 0 ? '' : `inset(${(1 - r) * 100}% 0 0 0)`;
        const v = layer.querySelector('video')!;
        v.style.transform = `scale(${lerp(1.18, 1, r)}) translate3d(0, ${lerp(6, 0, r)}%, 0)`;
        // copy enters after the wipe, leaves before the next one
        const local = q * n - i;                          // 0..1 while this chapter owns the screen
        const inA = i === 0 ? 1 : ease(span(local, -0.05, 0.3));
        const outA = i === n - 1 ? 1 : 1 - span(local, 0.72, 0.95);
        const vis = Math.min(inA, outA);
        copies[i].forEach((el, k) => {
          const d = ease(span(inA, k * 0.15, 1));
          el.style.opacity = String(Math.min(d, outA));
          el.style.transform = `translate3d(0, ${lerp(48, 0, d) - (1 - outA) * 40}px, 0)`;
        });
        layer.style.pointerEvents = vis > 0.5 ? '' : 'none';
        const bar = bars[i];
        bar.querySelector('b')!.style.transform = `scaleX(${clamp(local)})`;
        bar.toggleAttribute('data-on', local >= 0 && local < 1);
      });
      place.style.opacity = String(1 - span(q, 0.9, 1));

      // playback: opening film while scene 1 is on screen, side films once they arrive,
      // a chapter film while it is revealed and not yet fully covered by the next one.
      const openOn = inView(open), chapOn = inView(chap);
      want(gateV, openOn);
      sideV.forEach((v) => want(v, openOn && c > 0.01));
      layers.forEach((layer, i) => {
        const r = i === 0 ? 1 : io(span(q, i / n - 0.12, i / n + 0.1));
        const next = i + 1 < n ? io(span(q, (i + 1) / n - 0.12, (i + 1) / n + 0.1)) : 0;
        want(layer.querySelector('video')!, chapOn && r > 0 && next < 1);
      });
    }

    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', measure);
    measure();
    reduce.addEventListener('change', () => location.reload());
  }
</script>
