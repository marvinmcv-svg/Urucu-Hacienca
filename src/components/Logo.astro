---
// Wordmark recreated from the Instagram avatar. TODO(client): replace with the official vector logo.
interface Props { class?: string; tone?: 'ink' | 'cream' }
const { class: cls = '', tone = 'ink' } = Astro.props;
const color = tone === 'ink' ? 'var(--color-ink)' : 'var(--color-cream)';
---
<span class:list={['inline-flex flex-col items-center leading-none select-none', cls]} style={`color:${color}`} role="img" aria-label="Haciendas Urucú">
  <span aria-hidden="true" class="font-display text-[0.55em] tracking-[0.32em] pl-[0.32em]">HACIENDAS</span>
  <span aria-hidden="true" class="font-display text-[1.6em] font-semibold tracking-[0.04em] -mt-[0.02em]">URUCÚ</span>
  <span aria-hidden="true" class="mt-[0.18em] flex items-center gap-[0.35em] w-full">
    <span class="h-px flex-1" style={`background:${color};opacity:.5`}></span>
    <span class="font-display text-[0.55em] font-semibold text-copper">N</span>
    <span class="h-px flex-1" style={`background:${color};opacity:.5`}></span>
  </span>
</span>
