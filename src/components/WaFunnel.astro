---
// WhatsApp funnel: 4 steps (what you need → details → about you → send) beside a live WhatsApp preview.
// Nothing is sent from the site: the last step opens WhatsApp with the message written out.
import { services, chips, ft } from '../data/funnel';
import { WA_NUMBER } from '../lib/wa';
import { site } from '../data/site';
import type { Locale } from '../i18n/ui';
import Icon from './Icon.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const s = (k: keyof typeof ft) => ft[k][lang];
const steps = [s('step1'), s('step2'), s('step3'), s('step4')];
const herd = chips.find((c) => c.id === 'herd')!;
const detailChips = chips.filter((c) => c.id !== 'herd');
const cfg = {
  number: WA_NUMBER,
  services: Object.fromEntries(services.map((x) => [x.id, { label: x.title[lang], emoji: x.emoji, intent: x.intent }])),
  chips: Object.fromEntries(chips.map((c) => [c.id, { label: c.label[lang], emoji: c.emoji }])),
  txt: {
    hi: s('msgHi'), intro: s('msgIntro'), service: s('msgService'), note: s('msgNote'), thanks: s('msgThanks'),
    date: s('date'), people: s('people'), name: s('name'), ranch: s('ranch'), place: s('place'), needName: s('needName'),
  },
};
const field = 'mt-2 block w-full min-h-12 rounded-[4px] border border-paper/20 bg-paper/[0.04] px-4 py-3 text-base text-paper outline-none transition-colors placeholder:text-paper/40 hover:border-paper/40 focus:border-ember focus:bg-paper/[0.07]';
---
<section id="consulta" class="wf on-ink scroll-mt-20 bg-[#0e1310] text-paper" data-cfg={JSON.stringify(cfg)}>
  <div class="container-x grid gap-14 py-20 lg:grid-cols-[1.25fr_1fr] lg:gap-20 lg:py-28">
    <div class="min-w-0">
      <p class="label flex items-center gap-2.5 text-dust"><span class="size-2 rounded-full bg-achiote" aria-hidden="true"></span>{s('eyebrow')}</p>
      <h2 class="mt-5 text-[2.75rem] leading-[0.95] sm:text-6xl lg:text-[5.2rem]">{s('title1')} <em class="text-ember">{s('title2')}</em></h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-paper/70">{s('lead')}</p>

      <ol class="wf-tabs mt-10" role="list">
        {steps.map((name, i) => (
          <li><button type="button" data-goto={i} disabled={i > 0}><span class="num">0{i + 1}</span> · {name}</button></li>
        ))}
      </ol>

      <form class="wf-form mt-10" novalidate>
        <!-- 1 · What you need -->
        <fieldset class="wf-step" data-step="0">
          <legend class="label mb-5 text-paper/60">{s('choose')}</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            {services.map((x) => (
              <label class="wf-card">
                <input type="radio" name="service" value={x.id} class="sr-only" />
                <span class="wf-card-emoji" aria-hidden="true">{x.emoji}</span>
                <span class="block text-xl font-semibold leading-tight">{x.title[lang]}</span>
                <span class="mt-1 block text-[0.9375rem] leading-snug opacity-70">{x.sub[lang]}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- 2 · Details -->
        <fieldset class="wf-step" data-step="1" hidden>
          <legend class="sr-only">{s('step2')}</legend>
          <div class="grid gap-8">
            {detailChips.map((c) => (
              <div class="wf-group" data-for={c.for?.join(' ')} data-not={c.not?.join(' ')}>
                <p class="label text-paper/60">{c.label[lang]}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {c.options.map((op) => <label class="wf-chip"><input type="radio" name={c.id} value={op[lang]} class="sr-only" />{op[lang]}</label>)}
                </div>
              </div>
            ))}
            <div class="wf-group grid gap-4 sm:grid-cols-2" data-for="visit">
              <label class="text-sm font-semibold">{s('date')}<input name="date" type="date" class={field} /></label>
              <label class="text-sm font-semibold">{s('people')}<input name="people" type="number" inputmode="numeric" min="1" max="60" class:list={[field, 'num']} /></label>
            </div>
            <label class="text-sm font-semibold">{s('note')}<textarea name="note" rows="3" maxlength="500" placeholder={s('notePh')} class={field}></textarea></label>
          </div>
        </fieldset>

        <!-- 3 · About you -->
        <fieldset class="wf-step" data-step="2" hidden>
          <legend class="sr-only">{s('step3')}</legend>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="text-sm font-semibold sm:col-span-2">{s('name')}<input name="name" required autocomplete="name" class={field} /></label>
            <label class="text-sm font-semibold">{s('ranch')} <span class="font-normal text-paper/50">({s('optional')})</span><input name="ranch" autocomplete="organization" class={field} /></label>
            <label class="text-sm font-semibold">{s('place')} <span class="font-normal text-paper/50">({s('optional')})</span><input name="place" placeholder={s('placePh')} class={field} /></label>
            <div class="sm:col-span-2">
              <p class="label text-paper/60">{herd.label[lang]}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {herd.options.map((op) => <label class="wf-chip"><input type="radio" name="herd" value={op[lang]} class="sr-only" />{op[lang]}</label>)}
              </div>
            </div>
          </div>
          <p class="wf-err mt-4 text-sm text-ember" hidden role="alert"></p>
        </fieldset>

        <!-- 4 · Send -->
        <fieldset class="wf-step" data-step="3" hidden>
          <legend class="sr-only">{s('step4')}</legend>
          <h3 class="text-4xl leading-tight">{s('ready')}</h3>
          <p class="mt-3 max-w-lg leading-relaxed text-paper/70">{s('readyLead')}</p>
          <a class="wf-send mt-8 inline-flex min-h-14 items-center gap-3 rounded-[4px] bg-wa-dark px-8 text-base font-semibold text-white transition-colors hover:bg-[#0b6334]" href="#" target="_blank" rel="noopener" data-wa-intent="general">
            <Icon name="whatsapp" class="size-5" />{s('send')}
          </a>
        </fieldset>

        <div class="wf-nav mt-10 flex items-center gap-3">
          <button type="button" class="wf-back min-h-12 rounded-[4px] border border-paper/25 px-5 text-sm font-semibold transition-colors hover:border-paper" hidden>{s('back')}</button>
          <button type="button" class="wf-next inline-flex min-h-12 items-center gap-2 rounded-[4px] bg-paper px-6 text-sm font-semibold text-ink transition-colors hover:bg-white disabled:cursor-not-allowed disabled:opacity-40" hidden>{s('next')}<Icon name="arrow" class="size-4" /></button>
        </div>
      </form>
    </div>

    <!-- Live WhatsApp preview -->
    <div class="wf-preview">
      <div class="wf-phone" aria-hidden="true">
        <div class="wf-notch"></div>
        <div class="wf-head">
          <span class="wf-avatar">U</span>
          <span><b>Haciendas Urucú</b><small>{s('online')}</small></span>
        </div>
        <div class="wf-chat">
          <div class="wf-msg wf-in">{s('greet')}<time>09:41</time></div>
          <div class="wf-msg wf-out"><span class="wf-out-text"></span><time>09:42 <span class="wf-ticks">✓✓</span></time></div>
        </div>
        <div class="wf-bar"><span>{s('msgPh')}</span><i><svg viewBox="0 0 24 24" class="size-5" fill="currentColor"><path d="M3 20.5v-6l8-2.5-8-2.5v-6l19 8.5z" /></svg></i></div>
      </div>
      <p class="mt-6 text-center text-sm text-paper/55">{s('footnote')}</p>
      <p class="label mt-3 text-center text-paper/70"><a class="link-line" href={`https://wa.me/${WA_NUMBER}`} target="_blank" rel="noopener" data-wa-intent="general">WhatsApp {site.phoneDisplay} ↗</a></p>
    </div>
  </div>
</section>

<style is:global>
  .wf-tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; }
  .wf-tabs button { width: 100%; text-align: left; padding-top: .9rem; border-top: 2px solid rgb(242 236 225 / .15); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .75rem; letter-spacing: .02em; color: rgb(242 236 225 / .45); transition: color .3s, border-color .3s; }
  .wf-tabs button:not(:disabled) { cursor: pointer; }
  .wf-tabs button[data-done] { color: rgb(242 236 225 / .75); border-color: rgb(242 236 225 / .45); }
  .wf-tabs button[aria-current] { color: var(--color-paper); font-weight: 700; border-color: var(--color-achiote); }
  @media (max-width: 39.99rem) { .wf-tabs button { font-size: .6875rem; } .wf-tabs { gap: .4rem; } }

  .wf-card { position: relative; display: block; cursor: pointer; padding: 1.25rem 1.4rem 1.3rem; border-radius: 10px; border: 1px solid rgb(242 236 225 / .2); transition: background .25s, border-color .25s, color .25s, transform .4s var(--ease-out-expo); }
  .wf-card:hover { border-color: rgb(242 236 225 / .5); transform: translateY(-2px); }
  .wf-card:has(input:checked) { background: #fbf5dc; color: var(--color-ink); border-color: #fbf5dc; }
  .wf-card:has(input:checked)::after { content: ''; position: absolute; top: 1.1rem; right: 1.1rem; width: .45rem; height: .45rem; border-radius: 99px; background: var(--color-achiote); }
  .wf-card:has(input:focus-visible) { outline: 2px solid var(--color-ember); outline-offset: 3px; }
  .wf-card-emoji { position: absolute; right: 1.25rem; bottom: 1rem; font-size: 1.4rem; opacity: .35; transition: opacity .25s; }
  .wf-card:has(input:checked) .wf-card-emoji { opacity: 1; }

  .wf-chip { cursor: pointer; display: inline-flex; align-items: center; min-height: 2.75rem; padding: .5rem 1.05rem; border-radius: 999px; border: 1px solid rgb(242 236 225 / .22); font-size: .9375rem; transition: background .2s, border-color .2s, color .2s; }
  .wf-chip:hover { border-color: rgb(242 236 225 / .55); }
  .wf-chip:has(input:checked) { background: var(--color-paper); color: var(--color-ink); border-color: var(--color-paper); font-weight: 600; }
  .wf-chip:has(input:focus-visible) { outline: 2px solid var(--color-ember); outline-offset: 2px; }
  .wf input[type='date'] { color-scheme: dark; }

  .wf-step:not([hidden]) { animation: wf-in .5s var(--ease-out-expo); }
  @keyframes wf-in { from { opacity: 0; transform: translateY(10px); } }

  /* the phone */
  .wf-preview { display: none; }
  .wf[data-step='3'] .wf-preview { display: block; }
  @media (min-width: 64rem) { .wf-preview { display: block; position: sticky; top: 6.5rem; align-self: start; } }
  .wf-phone { position: relative; margin-inline: auto; width: min(100%, 23rem); height: 40rem; max-height: calc(100svh - 10rem); min-height: 30rem; display: flex; flex-direction: column; overflow: hidden;
    border-radius: 3rem; border: 10px solid #060807; box-shadow: 0 0 0 1px rgb(242 236 225 / .14), 0 50px 90px -30px rgb(0 0 0 / .9); background: #0b141a; }
  .wf-notch { position: absolute; top: .55rem; left: 50%; translate: -50% 0; width: 6.5rem; height: 1.7rem; border-radius: 99px; background: #000; z-index: 2; }
  .wf-head { display: flex; align-items: center; gap: .75rem; padding: 3rem 1.1rem .9rem; background: #1f2c34; }
  .wf-head b { display: block; font-size: 1.05rem; }
  .wf-head small { display: block; font-size: .8rem; color: rgb(242 236 225 / .6); }
  .wf-avatar { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 99px; background: var(--color-achiote); font-family: var(--font-display); font-size: 1.35rem; }
  .wf-chat { flex: 1; overflow-y: auto; padding: 1rem .8rem; display: flex; flex-direction: column; gap: .7rem; scrollbar-width: none;
    background: radial-gradient(circle at 20% 10%, rgb(255 255 255 / .03), transparent 40%), #0b141a; }
  .wf-msg { position: relative; max-width: 86%; padding: .6rem .75rem 1.3rem; border-radius: 10px; font-size: .9rem; line-height: 1.4; white-space: pre-wrap; overflow-wrap: anywhere; }
  .wf-msg time { position: absolute; right: .6rem; bottom: .3rem; font-size: .68rem; color: rgb(242 236 225 / .55); }
  .wf-in { align-self: flex-start; background: #202c33; border-top-left-radius: 2px; }
  .wf-out { align-self: flex-end; background: #005c4b; border-top-right-radius: 2px; min-width: 9rem; }
  .wf-ticks { color: #53bdeb; }
  .wf-bar { display: flex; align-items: center; gap: .6rem; padding: .7rem .8rem 1rem; background: #0b141a; }
  .wf-bar span { flex: 1; padding: .7rem 1rem; border-radius: 99px; background: #202c33; color: rgb(242 236 225 / .45); font-size: .9rem; }
  .wf-bar i { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 99px; background: var(--color-wa); color: #0b141a; }
  .wf-out .typing { color: rgb(242 236 225 / .6); font-style: italic; }
</style>

<script>
  type Cfg = {
    number: string;
    services: Record<string, { label: string; emoji: string; intent: string }>;
    chips: Record<string, { label: string; emoji: string }>;
    txt: Record<string, string>;
  };
  const root = document.querySelector<HTMLElement>('.wf')!;
  const cfg = JSON.parse(root.dataset.cfg!) as Cfg;
  const form = root.querySelector<HTMLFormElement>('.wf-form')!;
  const stepsEl = [...root.querySelectorAll<HTMLElement>('.wf-step')];
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-goto]')];
  const back = root.querySelector<HTMLButtonElement>('.wf-back')!;
  const next = root.querySelector<HTMLButtonElement>('.wf-next')!;
  const send = root.querySelector<HTMLAnchorElement>('.wf-send')!;
  const out = root.querySelector<HTMLElement>('.wf-out-text')!;
  const chat = root.querySelector<HTMLElement>('.wf-chat')!;
  const err = root.querySelector<HTMLElement>('.wf-err')!;
  const T = cfg.txt;
  let step = 0, reached = 0;

  const val = (n: string) => String(new FormData(form).get(n) ?? '').trim();

  function message(): string {
    const sv = cfg.services[val('service')];
    if (!sv) return '';
    const L: string[] = [T.hi, `${T.intro}:`, '', `${sv.emoji} *${T.service}:* ${sv.label}`];
    for (const id of ['breed', 'qty', 'doses', 'goal', 'when']) {
      const v = val(id), c = cfg.chips[id];
      if (v && isShown(id)) L.push(`${c.emoji} *${c.label}:* ${v}`);
    }
    if (val('service') === 'visit') {
      if (val('date')) L.push(`📅 *${T.date}:* ${val('date')}`);
      if (val('people')) L.push(`👥 *${T.people}:* ${val('people')}`);
    }
    if (val('note')) L.push(`📝 *${T.note}:* ${val('note')}`);
    const me = [
      val('name') && `👤 *${T.name}:* ${val('name')}`,
      val('ranch') && `🏡 *${T.ranch}:* ${val('ranch')}`,
      val('place') && `📍 *${T.place}:* ${val('place')}`,
      val('herd') && `${cfg.chips.herd.emoji} *${cfg.chips.herd.label}:* ${val('herd')}`,
    ].filter(Boolean) as string[];
    if (me.length) L.push('', ...me);
    L.push('', T.thanks);
    return L.join('\n');
  }

  // which detail groups apply to the chosen service
  function isShown(id: string) {
    const g = form.querySelector<HTMLElement>(`.wf-group [name="${id}"]`)?.closest<HTMLElement>('.wf-group');
    return !!g && !g.hidden;
  }
  function filterGroups() {
    const sv = val('service');
    form.querySelectorAll<HTMLElement>('.wf-group').forEach((g) => {
      const only = g.dataset.for?.split(' ').filter(Boolean);
      const not = g.dataset.not?.split(' ').filter(Boolean);
      g.hidden = (!!only?.length && !only.includes(sv)) || (!!not?.length && not.includes(sv));
    });
  }

  // render *bold* safely into the preview bubble
  function preview() {
    const text = message();
    out.replaceChildren();
    if (!text) { const i = document.createElement('span'); i.className = 'typing'; i.textContent = '…'; out.append(i); return; }
    text.split(/(\*[^*\n]+\*)/g).forEach((part) => {
      if (/^\*[^*\n]+\*$/.test(part)) { const b = document.createElement('b'); b.textContent = part.slice(1, -1); out.append(b); }
      else out.append(document.createTextNode(part));
    });
    chat.scrollTop = chat.scrollHeight;
    const sv = cfg.services[val('service')];
    send.href = `https://wa.me/${cfg.number}?text=${encodeURIComponent(text)}`;
    send.dataset.waIntent = sv?.intent ?? 'general';
  }

  function valid(i: number) {
    if (i === 0) return !!val('service');
    if (i === 2) return !!val('name');
    return true;
  }
  function go(i: number) {
    if (i > step && !valid(step)) {
      if (step === 2) { err.textContent = T.needName; err.hidden = false; form.querySelector<HTMLInputElement>('[name="name"]')!.focus(); }
      return;
    }
    err.hidden = true;
    step = i; reached = Math.max(reached, i);
    root.dataset.step = String(i);
    stepsEl.forEach((el, k) => (el.hidden = k !== i));
    tabs.forEach((b, k) => { b.toggleAttribute('aria-current', k === i); b.toggleAttribute('data-done', k !== i && k <= reached); b.disabled = k > reached; });
    back.hidden = i === 0;
    next.hidden = i === 0 || i === 3;
    if (i === 1) filterGroups();
    preview();
    if (i > 0) root.querySelector('.wf-tabs')!.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  form.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.name === 'service') { filterGroups(); preview(); setTimeout(() => go(1), 220); return; }
    preview();
  });
  form.addEventListener('input', preview);
  form.addEventListener('submit', (e) => e.preventDefault());
  next.addEventListener('click', () => go(step + 1));
  back.addEventListener('click', () => go(step - 1));
  tabs.forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.goto))));
  go(0);
</script>
