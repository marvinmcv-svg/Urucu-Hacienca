---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { locales, localeNames, href, useT, type Locale, type RouteKey } from '../i18n/ui';
// overlay: sits transparent over a full-bleed hero, then turns solid once the page scrolls.
interface Props { lang: Locale; altPaths: Record<Locale, string>; overlay?: boolean }
const { lang, altPaths, overlay = false } = Astro.props;
const t = useT(lang);
const nav: [RouteKey, Parameters<typeof t>[0]][] = [
  ['about', 'nav.about'], ['genetics', 'nav.genetics'], ['herd', 'nav.herd'], ['auctions', 'nav.auctions'], ['gallery', 'nav.gallery'], ['contact', 'nav.contact'],
];
const current = Astro.url.pathname;
---
<header id="site-header" data-overlay={overlay ? '' : undefined} class="site-header top-0 z-40 w-full">
  <div class="container-x flex h-[4.5rem] items-center justify-between gap-6 lg:h-20">
    <a href={href(lang)} class="py-2 text-[15px] lg:text-base" aria-label="Haciendas Urucú"><Logo /></a>
    <nav aria-label={t('nav.menu')} class="hidden lg:block">
      <ul class="flex items-center gap-1 text-[0.9375rem] font-medium">
        {nav.map(([r, k]) => {
          const h = href(lang, r);
          const active = current.startsWith(h);
          return <li><a href={h} aria-current={active ? 'page' : undefined} class="nav-link relative px-3.5 py-2">{t(k)}</a></li>;
        })}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <ul class="hidden items-center sm:flex" aria-label={t('nav.language')}>
        {locales.map((l) => (
          <li><a href={altPaths[l]} hreflang={l} lang={l} title={localeNames[l]} aria-current={l === lang ? 'true' : undefined}
            class="lang-link label grid h-10 min-w-10 place-items-center px-2">{l}</a></li>
        ))}
      </ul>
      <button type="button" id="menu-btn" class="menu-btn lg:hidden inline-flex h-11 items-center gap-2.5 rounded-[3px] border px-4 text-sm font-semibold" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" class="size-5" />{t('nav.menu')}
      </button>
    </div>
  </div>
  <div id="mobile-menu" hidden class="lg:hidden fixed inset-x-0 bottom-0 top-[4.5rem] overflow-y-auto bg-ink text-paper">
    <nav aria-label={t('nav.menu')} class="container-x flex min-h-full flex-col py-8">
      <ul class="flex flex-col">
        {nav.map(([r, k]) => {
          const h = href(lang, r);
          return <li><a href={h} aria-current={current.startsWith(h) ? 'page' : undefined} class="flex items-center justify-between border-b border-paper/15 py-4 font-display text-[2rem] leading-tight aria-[current=page]:text-ember">{t(k)}<Icon name="arrow" class="size-5 text-paper/50" /></a></li>;
        })}
      </ul>
      <ul class="mt-auto flex gap-2 pt-10" aria-label={t('nav.language')}>
        {locales.map((l) => <li><a href={altPaths[l]} hreflang={l} lang={l} class:list={['inline-flex h-11 items-center rounded-[3px] border px-4 text-sm font-semibold', l === lang ? 'border-ember text-ember' : 'border-paper/25']}>{localeNames[l]}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; background: color-mix(in srgb, var(--color-paper) 94%, transparent); color: var(--color-ink); border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent); transition: background-color .3s, color .3s, border-color .3s; }
  .site-header[data-overlay] { position: fixed; background: transparent; color: var(--color-paper); border-color: transparent; }
  .site-header[data-overlay][data-solid], .site-header[data-open] { background: var(--color-paper); color: var(--color-ink); border-color: color-mix(in srgb, var(--color-ink) 12%, transparent); }
  .site-header[data-open] { background: var(--color-ink); color: var(--color-paper); border-color: color-mix(in srgb, var(--color-paper) 15%, transparent); }
  .site-header[data-overlay]:not([data-solid]):not([data-open]) { background: linear-gradient(to bottom, rgb(20 28 23 / .55), transparent); }

  .nav-link::after { content: ''; position: absolute; left: .875rem; right: .875rem; bottom: .25rem; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .35s var(--ease-out-expo); }
  .nav-link:hover::after, .nav-link[aria-current="page"]::after { transform: scaleX(1); }
  .nav-link[aria-current="page"]::after { background: var(--color-achiote); height: 2px; }
  [data-overlay]:not([data-solid]) .nav-link[aria-current="page"]::after { background: var(--color-ember); }

  .lang-link { opacity: .6; transition: opacity .2s; }
  .lang-link:hover, .lang-link[aria-current="true"] { opacity: 1; }
  .lang-link[aria-current="true"] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .4em; text-decoration-color: var(--color-achiote); }
  [data-overlay]:not([data-solid]) .lang-link[aria-current="true"] { text-decoration-color: var(--color-ember); }

  .menu-btn { border-color: color-mix(in srgb, currentColor 30%, transparent); }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    header.toggleAttribute('data-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); } });
  if (header.hasAttribute('data-overlay')) {
    // Stay transparent over dark cinematic sections; turn solid once they have scrolled past.
    const dark = [...document.querySelectorAll<HTMLElement>('[data-header-dark]')];
    const onScroll = () => {
      const limit = dark.length ? Math.max(...dark.map((d) => d.offsetTop + d.offsetHeight)) - header.offsetHeight : 24;
      header.toggleAttribute('data-solid', scrollY > limit);
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
