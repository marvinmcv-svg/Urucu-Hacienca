---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import WaButton from '../../components/WaButton.astro';
import AnimalCard from '../../components/AnimalCard.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import { locales, href, useT, type Locale } from '../../i18n/ui';
import { animals } from '../../data/animals';
import { breeds, aiTotal } from '../../data/site';
import { upcoming } from '../../data/events';
import { photo } from '../../lib/media';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Locale;
const t = useT(lang);
const featured = animals.filter((a) => a.featured);
const next = upcoming()[0];
const fmt = (n: number) => n.toLocaleString(lang, { maximumFractionDigits: 2 });
---
<Base lang={lang}>
  <link slot="head" rel="preload" as="image" href="/media/poster/hero.jpg" fetchpriority="high" />
  <!-- Hero: full-bleed video on mobile, split editorial layout on desktop -->
  <section class="relative isolate overflow-hidden lg:bg-cream">
    <div class="container-x relative grid min-h-[88svh] items-end gap-10 pb-14 pt-24 lg:min-h-[calc(100svh-4.5rem)] lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:py-16">
      <div class="absolute inset-0 -z-10 lg:static lg:z-auto lg:order-2 lg:h-[min(78svh,46rem)]">
        <div class="relative size-full overflow-hidden lg:rounded-[2rem]">
          <video class="size-full object-cover" autoplay muted loop playsinline preload="metadata" poster="/media/poster/hero.jpg" aria-hidden="true">
            <source src="/media/video/hero.mp4" type="video/mp4" />
          </video>
          <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/40 to-ink/10 lg:bg-none"></div>
        </div>
      </div>
      <div class="text-cream lg:text-ink lg:order-1">
        <p class="eyebrow text-[#e9b58f]! lg:text-copper!">{t('home.hero.eyebrow')} · {t('meta.tagline')}</p>
        <h1 class="mt-5 text-[2.75rem] leading-[1.02] sm:text-6xl lg:text-7xl xl:text-[5.25rem]">{t('home.hero.title')}</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-cream/85 lg:text-ink-soft">{t('home.hero.lead')}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <WaButton intent="general" lang={lang}>{t('cta.talk')}</WaButton>
          <a href={href(lang, 'herd')} class="inline-flex items-center rounded-full border border-cream/50 px-6 py-3.5 text-sm font-semibold text-cream transition-colors hover:bg-cream hover:text-ink lg:border-ink/25 lg:text-ink lg:hover:bg-ink lg:hover:text-cream">{t('cta.herd')}</a>
        </div>
        <p class="mt-10 hidden text-sm text-ink-soft lg:block">Nelore · Nelore Mocho · Sindi</p>
      </div>
    </div>
  </section>

  <!-- Proof strip -->
  <section aria-label={t('home.proof.title')} class="bg-ink text-cream">
    <dl class="container-x grid divide-y divide-cream/10 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      <div data-reveal class="py-9 sm:px-8 sm:first:pl-0">
        <dt class="text-sm text-cream/70">{t('home.proof.champion_sub')}</dt>
        <dd class="mt-2 font-display text-3xl text-[#e9c27e]">★ {t('home.proof.champion')}</dd>
      </div>
      <div data-reveal class="py-9 sm:px-8">
        <dt class="text-sm text-cream/70">{t('home.proof.pregnancy_sub')}</dt>
        <dd class="mt-2 font-display text-3xl"><span class="text-[#e9b58f]">{fmt(aiTotal)}%</span> <span class="text-lg text-cream/85">{t('home.proof.pregnancy')}</span></dd>
      </div>
      <div data-reveal class="py-9 sm:px-8">
        <dt class="text-sm text-cream/70">{t('home.proof.top_sub')}</dt>
        <dd class="mt-2 font-display text-3xl">{t('home.proof.top')}</dd>
      </div>
    </dl>
  </section>

  <!-- Breeds -->
  <section class="container-x py-24 lg:py-32">
    <SectionHead eyebrow={t('home.breeds.eyebrow')} title={t('home.breeds.title')} />
    <div class="mt-14 grid gap-8 md:grid-cols-3">
      {breeds.map((b) => (
        <article data-reveal class="group">
          <div class="aspect-[4/5] overflow-hidden rounded-2xl">
            <Image src={photo(b.photo)} alt={b.name[lang]} widths={[480, 720, 960]} sizes="(min-width:768px) 33vw, 100vw" class="size-full object-cover transition-transform duration-700 group-hover:scale-105" />
          </div>
          <h3 class="mt-6 text-2xl">{b.name[lang]}</h3>
          <p class="mt-2 text-ink-soft leading-relaxed">{b.text[lang]}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Featured animals -->
  <section class="bg-bone/60 py-24 lg:py-32">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHead eyebrow={t('home.featured.eyebrow')} title={t('home.featured.title')} />
        <a href={href(lang, 'herd')} class="text-sm font-semibold text-copper hover:text-copper-dark">{t('cta.herd')} →</a>
      </div>
      <div class="mt-14 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((a) => <AnimalCard a={a} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- Video feature -->
  <section class="container-x grid items-center gap-12 py-24 lg:grid-cols-[1fr_0.7fr] lg:gap-20 lg:py-32">
    <div>
      <SectionHead eyebrow={t('home.video.eyebrow')} title={t('home.video.title')} lead={t('home.video.lead')} />
      <div data-reveal class="mt-9"><WaButton intent="genetics" lang={lang} vars={{ breed: 'Sindi' }} variant="copper">{t('cta.ask_genetics')}</WaButton></div>
    </div>
    <VideoPlayer id="expocruz-sindi-reel" title="Expocruz 2026 · Sindi" class="mx-auto w-full max-w-sm" />
  </section>

  <!-- Philosophy -->
  <section class="relative isolate overflow-hidden">
    <Image src={photo('campo-futuro')} alt="" widths={[800, 1400, 2000]} sizes="100vw" class="absolute inset-0 -z-10 size-full object-cover object-[50%_60%]" />
    <div class="absolute inset-0 -z-10 bg-ink/55"></div>
    <figure data-reveal class="container-x py-32 text-center text-cream lg:py-44">
      <blockquote class="mx-auto max-w-4xl font-display text-3xl leading-snug sm:text-4xl lg:text-5xl">“{t('home.philosophy.quote')}”</blockquote>
      <figcaption class="eyebrow mt-8 text-[#e9b58f]!">{t('home.philosophy.cite')}</figcaption>
    </figure>
  </section>

  <!-- Visit + next auction -->
  <section class="container-x grid gap-12 py-24 lg:grid-cols-2 lg:gap-20 lg:py-32">
    <div data-reveal class="overflow-hidden rounded-2xl">
      <Image src={photo('visita-pesqueria')} alt={t('home.visit.title')} widths={[600, 900, 1200]} sizes="(min-width:1024px) 50vw, 100vw" class="aspect-[4/5] size-full object-cover" />
    </div>
    <div class="flex flex-col justify-center">
      <SectionHead eyebrow={t('home.visit.eyebrow')} title={t('home.visit.title')} lead={t('home.visit.lead')} />
      <div data-reveal class="mt-9 flex flex-wrap gap-3">
        <WaButton intent="visit" lang={lang}>{t('cta.visit')}</WaButton>
        <a href={href(lang, 'about')} class="inline-flex items-center rounded-full border border-ink/25 px-6 py-3.5 text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">{t('nav.about')}</a>
      </div>
      <div data-reveal class="mt-14 rounded-2xl border border-ink/10 bg-white/50 p-6">
        <p class="eyebrow">{t('auctions.next')}</p>
        {next
          ? <p class="mt-3 font-display text-2xl">{next.name}</p>
          : <p class="mt-3 text-ink-soft">{t('auctions.next_tbd')}</p>}
        <a href={href(lang, 'auctions')} class="mt-4 inline-block text-sm font-semibold text-copper hover:text-copper-dark">{t('nav.auctions')} →</a>
      </div>
    </div>
  </section>
</Base>
