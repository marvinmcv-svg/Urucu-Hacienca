---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import SectionHead from '../../../components/SectionHead.astro';
import VideoPlayer from '../../../components/VideoPlayer.astro';
import LinkButton from '../../../components/LinkButton.astro';
import { locales, useT, type Locale } from '../../../i18n/ui';
import { videos, galleryPhotos } from '../../../data/videos';
import { site } from '../../../data/site';
import { photo } from '../../../lib/media';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Locale;
const t = useT(lang);
const [explains, ...rest] = [...videos.filter((v) => v.series === 'explains'), ...videos.filter((v) => !v.series)];
---
<Base lang={lang} title={t('gallery.title')} description={t('gallery.lead')} image={photo('expocruz-presente')}>
  <PageHero label={t('gallery.eyebrow')} title={t('gallery.title')} lead={t('gallery.lead')} />

  <section class="container-x grid items-center gap-14 pb-24 lg:grid-cols-[1fr_minmax(0,24rem)] lg:gap-24 lg:pb-36">
    <SectionHead title={explains.title[lang]} lead={t('about.philosophy.body')} meta={t('gallery.explains')} />
    <VideoPlayer id={explains.id} title={explains.title[lang]} credit={explains.credit} class="mx-auto w-full max-w-sm" />
  </section>

  <section class="on-ink bg-ink py-24 text-paper lg:py-36">
    <div class="container-x">
      <SectionHead tone="paper" title={t('gallery.videos')} size="md" />
      <div class="mt-14 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 md:grid-cols-3 lg:grid-cols-4">
        {rest.map((v) => <VideoPlayer id={v.id} title={v.title[lang]} credit={v.credit} tone="ink" />)}
      </div>
    </div>
  </section>

  <section class="container-x py-24 lg:py-36">
    <SectionHead title={t('gallery.photos')} size="md" />
    <div class="mt-14 columns-2 gap-4 sm:gap-6 md:columns-3 [&>*]:mb-4 sm:[&>*]:mb-6">
      {galleryPhotos.map((p) => (
        <figure class="break-inside-avoid overflow-hidden rounded-[2px] bg-paper-deep">
          <Image src={photo(p.id)} alt={p.alt[lang]} widths={[400, 700, 1000]} sizes="(min-width:768px) 33vw, 50vw" class="w-full" />
        </figure>
      ))}
    </div>
    <p class="mt-12 text-center"><LinkButton href={site.instagram} external>{t('gallery.follow')} · @haciendasurucu</LinkButton></p>
  </section>
</Base>
