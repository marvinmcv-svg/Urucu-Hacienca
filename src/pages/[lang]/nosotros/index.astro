---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import SectionHead from '../../../components/SectionHead.astro';
import VideoPlayer from '../../../components/VideoPlayer.astro';
import WaButton from '../../../components/WaButton.astro';
import { locales, useT, type Locale } from '../../../i18n/ui';
import { partners } from '../../../data/site';
import { photo } from '../../../lib/media';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Locale;
const t = useT(lang);
const values = [1, 2, 3, 4] as const;
---
<Base lang={lang} title={t('about.eyebrow')} description={t('about.lead')} image={photo('campo-futuro')} overlay>
  <PageHero label={t('about.eyebrow')} title={t('about.title')} lead={t('about.lead')} image="campo-futuro" position="50% 65%" />

  <section class="container-x grid gap-16 py-24 lg:grid-cols-2 lg:gap-24 lg:py-36">
    <SectionHead title={t('about.story.title')} lead={t('about.story.body')} />
    <dl class="border-t border-ink/25 lg:mt-3">
      {values.map((n) => (
        <div class="grid gap-2 border-b border-ink/15 py-6 sm:grid-cols-[12rem_1fr] sm:gap-8">
          <dt class="font-display text-2xl italic leading-tight">{t(`about.values.${n}`)}</dt>
          <dd class="leading-relaxed text-ink-soft">{t(`about.values.${n}d`)}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="on-ink bg-ink py-24 text-paper lg:py-36">
    <div class="container-x grid items-center gap-14 lg:grid-cols-[minmax(0,24rem)_1fr] lg:gap-24">
      <VideoPlayer id="pasturas-pesqueria" title={t('about.pesqueria.title')} credit="@gramaseed.srl" tone="ink" class="mx-auto w-full max-w-sm" />
      <div>
        <SectionHead tone="paper" title={t('about.pesqueria.title')} lead={t('about.pesqueria.body')} meta="San Matías · Santa Cruz" />
        <div class="mt-10"><WaButton intent="visit" lang={lang}>{t('cta.visit')}</WaButton></div>
      </div>
    </div>
  </section>

  <section class="container-x grid items-center gap-14 py-24 lg:grid-cols-[1fr_minmax(0,24rem)] lg:gap-24 lg:py-36">
    <SectionHead title={t('about.philosophy.title')} lead={t('about.philosophy.body')} meta={t('gallery.explains')} />
    <VideoPlayer id="rusticidad-explica" title={`${t('gallery.explains')}: ${t('about.values.1')}`} class="mx-auto w-full max-w-sm" />
  </section>

  <section class="border-t border-ink/15 bg-paper-deep/50">
    <div class="container-x grid gap-12 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24 lg:py-28">
      <SectionHead title={t('about.partners.title')} lead={t('about.partners.body')} size="md" />
      <ul class="self-center border-t border-ink/25">
        {partners.map((p) => <li class="border-b border-ink/15 py-4 font-display text-3xl leading-tight lg:text-4xl">{p}</li>)}
      </ul>
    </div>
  </section>
</Base>
