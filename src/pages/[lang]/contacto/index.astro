---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import WaFunnel from '../../../components/WaFunnel.astro';
import { locales, useT, type Locale } from '../../../i18n/ui';
import { intents, waLink } from '../../../lib/wa';
import { site } from '../../../data/site';
import { photo } from '../../../lib/media';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Locale;
const t = useT(lang);
---
<Base lang={lang} title={t('contact.title')} description={t('contact.lead')} band={false}>
  <PageHero label={t('contact.eyebrow')} title={t('contact.title')} lead={t('contact.lead')} />

  <WaFunnel lang={lang} />

  <section class="container-x grid gap-16 py-24 lg:grid-cols-2 lg:gap-24 lg:py-32">
    <div>
      <ul class="border-t border-ink/25">
        {intents.map((i) => (
          <li><a href={waLink(i, lang)} target="_blank" rel="noopener" data-wa-intent={i}
            class="group flex min-h-20 items-center justify-between gap-6 border-b border-ink/15 py-5 transition-colors hover:text-wa-dark">
            <span class="font-display text-2xl leading-tight sm:text-[1.75rem]">{t(`intent.${i}` as const)}</span>
            <span aria-hidden="true" class="grid size-11 shrink-0 place-items-center rounded-full bg-wa-dark text-white transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-1"><Icon name="whatsapp" class="size-[1.1rem]" /></span>
          </a></li>
        ))}
      </ul>
    </div>
    <div>
      <Image src={photo('visita-pesqueria')} alt="" widths={[600, 900]} sizes="(min-width:1024px) 50vw, 100vw" class="h-64 w-full rounded-[2px] object-cover object-[50%_70%]" />
      <dl class="mt-10 grid gap-10 sm:grid-cols-2">
        <div><dt class="label text-achiote">{t('contact.where')}</dt><dd class="mt-3 leading-relaxed">{site.location.ranch}<br />{site.location.area}<br /><a class="link-line mt-2 inline-flex items-center gap-1.5 font-semibold text-achiote" href={site.location.maps} target="_blank" rel="noopener"><Icon name="pin" />Google Maps</a></dd></div>
        <div><dt class="label text-achiote">{t('contact.social')}</dt><dd class="mt-3 grid gap-1.5"><a class="link-line" href={site.instagram} target="_blank" rel="noopener">Instagram · @haciendasurucu</a><a class="link-line" href={site.facebook} target="_blank" rel="noopener">Facebook</a><span class="num">WhatsApp {site.phoneDisplay}</span></dd></div>
      </dl>
    </div>
  </section>
</Base>
