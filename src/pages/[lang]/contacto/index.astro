---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import { locales, useT, type Locale } from '../../../i18n/ui';
import { intents, waLink } from '../../../lib/wa';
import { site } from '../../../data/site';
import { photo } from '../../../lib/media';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Locale;
const t = useT(lang);
const labels = {
  name: t('contact.visit.name'), ranch: t('contact.visit.ranch'), date: t('contact.visit.date'),
  people: t('contact.visit.people'), interest: t('contact.visit.interest'),
};
const field = 'mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 outline-none focus:border-copper';
---
<Base lang={lang} title={t('contact.title')} description={t('contact.lead')} band={false}>
  <PageHero eyebrow={t('contact.eyebrow')} title={t('contact.title')} lead={t('contact.lead')} />

  <section class="container-x grid gap-12 pb-24 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20 lg:pb-32">
    <div>
      <ul class="grid gap-3">
        {intents.map((i) => (
          <li><a href={waLink(i, lang)} target="_blank" rel="noopener" data-wa-intent={i}
            class="flex items-center justify-between rounded-2xl border border-ink/10 bg-white/60 px-6 py-5 transition-colors hover:border-wa-dark hover:bg-white">
            <span class="font-display text-xl">{t(`intent.${i}` as const)}</span>
            <span aria-hidden="true" class="grid size-9 place-items-center rounded-full bg-wa-dark text-white">→</span>
          </a></li>
        ))}
      </ul>
      <dl class="mt-12 grid gap-6 text-sm sm:grid-cols-2">
        <div><dt class="eyebrow">{t('contact.where')}</dt><dd class="mt-2 leading-relaxed">{site.location.ranch}<br />{site.location.area}<br /><a class="text-copper underline underline-offset-4" href={site.location.maps} target="_blank" rel="noopener">Google Maps</a></dd></div>
        <div><dt class="eyebrow">{t('contact.social')}</dt><dd class="mt-2 grid gap-1"><a class="hover:text-copper" href={site.instagram} target="_blank" rel="noopener">Instagram @haciendasurucu</a><a class="hover:text-copper" href={site.facebook} target="_blank" rel="noopener">Facebook</a><span>WhatsApp {site.phoneDisplay}</span></dd></div>
      </dl>
    </div>

    <div class="overflow-hidden rounded-3xl bg-white/70 ring-1 ring-ink/10">
      <Image src={photo('visita-pesqueria')} alt="" widths={[600, 900]} sizes="(min-width:1024px) 50vw, 100vw" class="h-56 w-full object-cover object-[50%_70%]" />
      <form id="visit-form" class="grid gap-5 p-6 sm:grid-cols-2 sm:p-10" data-lang={lang} data-labels={JSON.stringify(labels)}>
        <h2 class="text-2xl sm:col-span-2">{t('contact.visit.title')}</h2>
        <label class="text-sm font-medium">{labels.name}<input required name="name" autocomplete="name" class={field} /></label>
        <label class="text-sm font-medium">{labels.ranch}<input name="ranch" autocomplete="organization" class={field} /></label>
        <label class="text-sm font-medium">{labels.date}<input required name="date" type="date" class={field} /></label>
        <label class="text-sm font-medium">{labels.people}<input required name="people" type="number" min="1" max="60" value="2" class={field} /></label>
        <label class="text-sm font-medium sm:col-span-2">{labels.interest}<textarea name="interest" rows="3" class={field}></textarea></label>
        <div class="sm:col-span-2">
          <button type="submit" data-wa-intent="visit" class="inline-flex items-center gap-2 rounded-full bg-wa-dark px-7 py-3.5 text-sm font-semibold text-white hover:bg-[#0b6334]">{t('contact.visit.submit')} →</button>
          <p class="mt-3 text-xs text-ink-soft">{t('contact.visit.note')}</p>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  import { waLink } from '../../../lib/wa';
  import type { Locale } from '../../../i18n/ui';
  const form = document.getElementById('visit-form') as HTMLFormElement;
  const lang = form.dataset.lang as Locale;
  const L = JSON.parse(form.dataset.labels!) as Record<string, string>;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const lines = (['name', 'ranch', 'date', 'people', 'interest'] as const)
      .map((k) => [k, String(d.get(k) ?? '').trim()] as const)
      .filter(([, v]) => v)
      .map(([k, v]) => `${L[k]}: ${v}`);
    window.open(waLink('visit', lang, {}, lines.join('\n')), '_blank', 'noopener');
  });
</script>
