# Server-side only. Set in Vercel → Project → Settings → Environment Variables. Never commit a real key.
NVIDIA_API_KEY=
# Optional. Defaults to nvidia/nemotron-3.5-lightning-30b-a3b (NVIDIA API catalog, OpenAI-compatible).
MARVIN_MODEL=
# Optional. "true" turns on the model's reasoning: slower replies, the reasoning itself is never shown.
MARVIN_THINKING=
# Optional. Tried in order when the main model fails or is slow to start. Comma-separated.
MARVIN_FALLBACK_MODELS=nvidia/nemotron-3.5-bolt-e4b,google/gemma-4-31b-it
# Public address of the site, used for canonical links, the sitemap and preview images.
# Defaults to https://haciendas-urucu.vercel.app. Set it when the ranch's own domain is connected.
SITE_URL=
