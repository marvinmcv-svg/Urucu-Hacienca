# Server-side only. Set in Vercel → Project → Settings → Environment Variables. Never commit a real key.
NVIDIA_API_KEY=
# Optional. Defaults to nvidia/nemotron-3-ultra-550b-a55b (NVIDIA API catalog, OpenAI-compatible).
MARVIN_MODEL=
# Optional. "true" turns on the model's reasoning: slower replies, the reasoning itself is never shown.
MARVIN_THINKING=
# Optional. Tried in order when the main model fails or is slow to start. Comma-separated.
MARVIN_FALLBACK_MODELS=meta/llama-3.3-70b-instruct
